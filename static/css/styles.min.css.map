@media (min-width: 507px) and (max-width: 980px) {
  #posts-sticky > article {
    float: left;
  }
  #posts-sticky > article:nth-child(2),
  #posts-sticky > article:nth-child(5),
  #posts-sticky > article:nth-child(7),
  #posts-sticky > article:nth-child(9) {
    float: right;
  }
  #posts-sticky > article:nth-child(3) {
    width: 100%;
  }
  #posts-sticky > article:nth-child(3) a .category {
    font-size: 0.6rem;
    line-height: 0.68rem;
    padding: 2.4rem 0rem 0.72rem 0rem;
  }
  #posts-sticky > article:nth-child(3) a .title {
    font-size: 1.48rem;
    line-height: 2.12rem;
    padding-right: 4rem;
    padding-left: 4rem;
