  src: url(https://fonts.gstatic.com/s/overpassmono/v21/_Xm5-H86tzKDdAPa-KPQZ-AC_COcRycquHlL6EUzpXz0VO4.ttf) format('truetype');
}
.fa-hugging-face {
  aspect-ratio: 1;
  background: url('/img/icon-huggingface.svg') 0% 120% no-repeat;
  display: inline-block;
  position: relative;
  top: 1px;
  width: 0.84rem;
}
.fa-substack {
  aspect-ratio: 1;
  background: url('/img/icon-substack.svg') 0% 120% no-repeat;
  display: inline-block;
  position: relative;
  top: 1px;
  width: 0.64rem;
}
.fa-substack-white {
  aspect-ratio: 1;
  background: url('/img/icon-substack-white.svg') 0% 120% no-repeat;
  display: inline-block;
  position: relative;
  top: 1px;
  width: 0.64rem;
}
.fa-beehiiv {
  aspect-ratio: 1;
  background: url('/img/icon-beehiiv.svg') 0% 120% no-repeat;
  display: inline-block;
  position: relative;
  top: 1px;
  width: 0.64rem;
}
.serif {
  font-family: 'Martel', serif;
}
.sans-serif {
  font-family: 'Open Sans', 'Helvetica Neue', sans-serif;
}
* {
  font-weight: 400;
  letter-spacing: 0.008rem;
}
html {
  font-size: 15px;
}
body {
  background: var(--color-off-white);
  margin: 0px;
  min-width: 320px;
  padding: 0px;
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
}
h1 {
  font-family: var(--font-serif);
  color: var(--color-white);
  font-size: 1.52rem;
  letter-spacing: 0px !important;
  line-height: 2.28rem;
  margin: 0px;
}
h2,
h2 > span,
h3,
h3 > span {
  font-family: var(--font-serif);
  font-weight: 300 !important;
  letter-spacing: 0px;
  margin: 0px;
}
h2 {
  font-size: 1.28rem;
  line-height: 1.92rem;
}
#content-body > .container h2 {
  margin: 3rem 0rem 1.92rem 0rem !important;
}
h3 {
  font-size: 1.04rem;
  line-height: 1.56rem;
}
#content-body > .container h3 {
  margin: 0rem 0rem 1.56rem 0rem !important;
}
h4,
h4 > span,
h5,
h5 > span {
  font-family: var(--font-sans-serif);
  letter-spacing: 0px !important;
}
#content-body > .container h4 {
  font-size: 1.04rem;
  line-height: 1.56rem;
  margin: 0rem 0rem 1.56rem 0rem;
}
#content-body > .container h5 {
  font-size: 0.88rem;
  line-height: 1.32rem;
  margin: 0rem 0rem 1.32rem 0rem;
}
p,
li {
  font-family: var(--font-serif);
  color: var(--color-gray-medium);
  font-size: 0.8rem;
}
p {
  line-height: 1.6rem;
  margin: 0rem 0rem 1.8rem 0rem;
}
a {
  color: var(--color-orange);
  -moz-text-decoration-color: var(--color-gray-light);
  -webkit-text-decoration-color: var(--color-gray-light);
  text-decoration-color: var(--color-gray-light);
  -moz-text-decoration-style: dotted;
  -webkit-text-decoration-style: dotted;
  text-decoration-style: dotted;
}
a:hover,
a:focus {
  color: var(--color-orange-light);
  -moz-text-decoration-color: var(--color-orange-light);
  -webkit-text-decoration-color: var(--color-orange-light);
  text-decoration-color: var(--color-orange-light);
  -moz-text-decoration-style: solid;
  -webkit-text-decoration-style: solid;
  text-decoration-style: solid;
}
pre {
  margin: -1rem 0rem 1rem 0rem;
}
pre > code,
pre > code * {
  font-family: monospace, "Courier New" !important;
  font-size: 0.72rem;
  letter-spacing: 0px !important;
  line-height: 1rem !important;
}
pre:not(.julia):not(.python):not(.r):not(.sql):not(.html):not(.javascript):not(.js):not(.css):not(.gherkin):not(.cpp):not(.c):not(.cuda):not(.bash):not(.shell):not(.json):not(.yaml) > code,
pre:not(.julia):not(.python):not(.r):not(.sql):not(.html):not(.javascript):not(.js):not(.css):not(.gherkin):not(.cpp):not(.c):not(.cuda):not(.bash):not(.shell):not(.json):not(.yaml) > code * {
  background: var(--color-off-white) !important;
  color: #777 !important;
  font-style: italic !important;
}
p > code {
  background: var(--color-white);
  font-family: monospace, "Courier New" !important;
  letter-spacing: 0px !important;
  padding: 0rem 0.2rem;
}
.highlight {
  background: var(--color-highlighter);
  color: var(--color-gray-dark);
}
.content-cta {
  background: var(--color-white);
  color: var(--color-gray-medium);
  font-size: 1rem;
  line-height: 1.6rem;
  padding: 1.2rem 2rem;
  text-align: center;
}
.content-cta a {
  display: block;
  margin-top: 2rem;
}
p > code,
.highlight code {
  color: #000 !important;
}
aside {
  font-family: var(--font-sans-serif);
  background: var(--color-white);
  color: var(--color-gray-dark);
  font-size: 0.72rem;
  line-height: 1.2rem;
  margin: 2.2rem 0rem;
  padding: 1rem 1.8rem;
  text-align: center;
}
.hr-major,
.hr-minor {
  display: block;
  height: 0.36rem;
  margin: 2.6rem 0rem;
  width: 3.4rem;
}
.hljs-keyword,
.hljs-selector-tag,
.hljs-addition {
  color: var(--color-green) !important;
}
.hljs-number,
.hljs-string,
.hljs-meta .hljs-meta-string,
.hljs-literal,
.hljs-doctag,
.hljs-regexp {
  color: var(--color-blue) !important;
}
.hljs-built_in,
.hljs-deletion {
  color: var(--color-orange) !important;
}
.hr-major {
  background: var(--color-orange);
}
.hr-minor {
  background: var(--color-blue);
}
.container {
  margin-right: 2.4rem;
  margin-left: 2.4rem;
  padding: 0px;
}
.full-vw {
  left: -2.4rem;
  position: relative;
  width: 100vw;
  right: -2.4rem;
}
.clearfix {
  clear: both;
}
a.btn,
button.btn {
  font-family: var(--font-sans-serif);
  cursor: pointer;
  display: inline-block;
  border-radius: 25em;
  font-size: 0.8rem;
  font-weight: 600 !important;
  letter-spacing: -0.008rem !important;
  padding: 0.64rem 1.64rem;
  text-decoration: none;
  -moz-transition: background 0.24s ease, color 0.24s ease;
  -webkit-transition: background 0.24s ease, color 0.24s ease;
  -o-transition: background 0.24s ease, color 0.24s ease;
  -ms-transition: background 0.24s ease, color 0.24s ease;
  transition: background 0.24s ease, color 0.24s ease;
}
a.btn-default,
button.btn-default {
  background: var(--color-gray-dark);
  color: var(--color-white);
}
a.btn-default:hover,
a.btn-default:focus,
button.btn-default:hover,
button.btn-default:focus {
  background: var(--color-gray-medium);
}
a.btn-primary,
button.btn-primary {
  background: var(--color-orange);
  color: var(--color-white);
}
a.btn-primary:hover,
a.btn-primary:focus,
button.btn-primary:hover,
button.btn-primary:focus {
  background: var(--color-orange-light);
}
a.btn-secondary,
button.btn-secondary {
  background: var(--color-blue);
  color: var(--color-white);
}
a.btn-secondary:hover,
a.btn-secondary:focus,
button.btn-secondary:hover,
button.btn-secondary:focus {
  background: var(--color-blue-light);
}
/* Off-canvas menu open (functions.js): lock the page underneath. <body> is
   pinned at the current scroll offset (its inline top is set by the script),
   which also stops iOS Safari from scrolling it. */
html.nav-open {
  overflow: hidden;
}
html.nav-open body {
  left: 0px;
  overflow: hidden;
  position: fixed;
  right: 0px;
}
.category {
  font-family: var(--font-sans-serif);
  color: var(--color-blue);
  display: inline-block;
  font-size: 0.6rem;
  font-weight: 600 !important;
  letter-spacing: 0.08rem !important;
  padding-bottom: 0.6rem;
  text-transform: uppercase;
}
.clear {
  clear: both;
}
.overlay {
  --color-cmp-overlay: var(--color-gray-dark) !important;
  --feature-overlay-opacity: 0.77 !important;
}
/*  iPhone 4, 5 (320 px)  */
/*  iPhone 6, 7, 8, SE, X (375 px)  */
@media (min-width: 375px) and (max-width: 389px) {
  html {
    font-size: 17.4px;
  }
}
/*  iPhone 12 Pro  */
@media (min-width: 390px) and (max-width: 413px) {
  html {
    font-size: 17.4px;
  }
}
/*  iPhone 6+, 7+, 8+, XR (320 px)  */
@media (min-width: 414px) and (max-width: 429px) {
  html {
    font-size: 18px;
  }
}
/*  iPhone 14 Pro Max (430 px)  */
@media (min-width: 430px) and (max-width: 506px) {
  html {
    font-size: 18px;
  }
}
@media (min-width: 507px) {
  .hr-major,
  .hr-minor {
    width: 3.6rem;
  }
}
@media (min-width: 507px) and (max-width: 991px) {
  .container {
    margin-right: 3.6rem;
    margin-left: 3.6rem;
  }
}
@media (min-width: 507px) and (max-width: 550px) {
  html {
    font-size: 15px;
  }
  .category {
    font-size: 0.52rem;
    letter-spacing: 0.052rem !important;
  }
}
@media (min-width: 551px) and (max-width: 677px) {
  html {
    font-size: 17.8px;
  }
}
@media (min-width: 678px) and (max-width: 767px) {
  html {
    font-size: 18px;
  }
}
@media (min-width: 768px) and (max-width: 819px) {
  html {
    font-size: 24px;
  }
}
@media (min-width: 820px) and (max-width: 980px) {
  html {
    font-size: 25.75px;
  }
}
@media (min-width: 981px) {
  html {
    font-size: 15px;
  }
  h1 {
    font-size: 1.92rem;
    line-height: 2.88rem;
  }
  h2 {
    font-size: 1.4rem;
    line-height: 2.1rem;
  }
  h3 {
    font-size: 1.16rem;
    line-height: 1.74rem;
  }
  h4,
  h4 > span,
  h5,
  h5 > span {
    font-family: var(--font-sans-serif);
  }
  p {
    font-size: 0.76rem;
    line-height: 1.52rem;
  }
  .container {
    margin-right: 2rem;
    margin-left: 2rem;
  }
  .hr-major,
  .hr-minor {
    width: 4.2rem;
  }
  .category {
    font-size: 0.56rem;
    letter-spacing: 0.06rem;
  }
}
@media (min-width: 1112px) {
  html {
    font-size: 14.75px;
  }
  .hr-major,
  .hr-minor {
    width: 4.8rem;
  }
  #page-container {
    margin: 0rem 4.8rem;
  }
}
@media (min-width: 1200px) {
  html {
    font-size: 16px;
  }
}
@media (min-width: 1366px) {
  html {
    font-size: 17.75px;
  }
}
@media (min-width: 1400px) {
  html {
    font-size: 18.25px;
  }
}
@media (min-width: 1600px) {
  html {
    font-size: 21px;
  }
}
@media (min-width: 1800px) {
  html {
    font-size: 24px;
  }
}
@media (min-width: 1920px) {
  html {
    font-size: 25px;
  }
}
@media (min-width: 2000px) {
  html {
    font-size: 26px;
  }
}
@media (min-width: 2200px) {
  html {
    font-size: 28px;
  }
}
@media (min-width: 2400px) {
  html {
    font-size: 31px;
  }
}
@media (min-width: 2600px) {
  html {
    font-size: 34px;
  }
}
@media (min-width: 2800px) {
  html {
    font-size: 36px;
  }
}
@media (min-width: 3000px) {
  html {
    font-size: 39px;
  }
}
#header {
  left: 0px;
  margin: 0px;
  padding: 0px;
  position: absolute;
  top: 3.4rem;
  width: 100%;
  z-index: 99;
}
#header .container {
  position: relative;
}
#header #logo-mm {
  background: url('https://www.michaelmallari.com/img/logo-mm-white-cutout.svg') no-repeat;
  background-size: 3.4rem 3.4rem;
  display: inline-block;
  margin: 0px;
  height: 3.4rem;
  width: 3.4rem;
}
button#hamburger-menu {
  background: none;
  border: none;
  display: inline-block;
  float: right;
  height: 3.4rem;
  margin: 0px;
  outline: none;
  padding: 0rem 0.36rem 0rem 0rem;
  position: relative;
  right: 0px;
  z-index: 99;
}
body#landing button#hamburger-menu {
  display: none;
}
button#hamburger-menu svg#hamburger-menu-open {
  transform: scale(1.8);
}
button#hamburger-menu svg#hamburger-menu-close {
  display: none;
  transform: scale(1.8);
}
button#hamburger-menu.toggle-hamburger-menu-close svg#hamburger-menu-open {
  display: none;
}
button#hamburger-menu.toggle-hamburger-menu-close svg#hamburger-menu-close {
  display: inline-block;
}
button#hamburger-menu span {
  font-family: var(--font-sans-serif);
  color: var(--color-white);
  display: inline-block;
  float: left;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08rem !important;
  margin: 0px;
  padding: 0px 16px 0px 0px;
  text-transform: uppercase;
}
button#hamburger-menu span:after {
  content: 'Menu';
}
button#hamburger-menu.toggle-hamburger-menu-close span:after {
  color: var(--color-orange);
  content: 'Close';
}
body#landing button#hamburger-menu {
  display: none;
}
#header #nav {
  background: var(--color-white);
  max-height: 100vh;
  max-height: 100dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
  position: fixed;
  right: -5000px;
  top: 0px;
  -moz-transition: right 0.32s ease;
  -webkit-transition: right 0.32s ease;
  -o-transition: right 0.32s ease;
  -ms-transition: right 0.32s ease;
  transition: right 0.32s ease;
  width: 100%;
  z-index: 90;
}
body#landing #header #nav {
  display: none;
}
#header #nav.expanded {
  right: 0px !important;
}
button#close-menu {
  background: none;
  border: none;
  display: block;
  float: right;
  height: 3.4rem;
  margin: 3.2rem 0rem 2rem 0rem;
  outline: none;
  padding: 0px;
  right: 0px;
}
button#close-menu label {
  font-family: var(--font-sans-serif);
  color: var(--color-gray-dark);
  display: inline-block;
  float: left;
  font-size: 0.76rem;
  font-weight: 600 !important;
  letter-spacing: 0.04rem !important;
  margin: 0px;
  padding: 0rem 0.6rem 0rem 0rem;
  text-transform: uppercase;
}
.nav-primary {
  display: block;
  list-style: none;
  margin: 10rem 0rem 0rem 0rem;
  padding: 0px;
}
.nav-primary li {
  display: block;
  margin: 0px;
  padding: 0px;
  text-align: center;
}
.nav-primary a {
  display: block;
  padding: 1.2rem 0rem;
  text-decoration: none !important;
}
.nav-primary a span {
  color: var(--color-blue);
  font-size: 0.92rem;
  margin: 0px;
  padding: 0px;
  width: 2.6rem;
}
.nav-primary a span:nth-child(2) {
  font-family: var(--font-sans-serif);
  color: var(--color-gray-dark);
  display: inline-block;
  font-size: 0.76rem;
  font-weight: 700 !important;
  letter-spacing: 0.02rem !important;
  text-align: left;
  text-transform: uppercase;
  width: 7.6rem;
}
@media (min-width: 375px) {
  #header {
    top: 3.4rem;
  }
  button#hamburger-menu {
    padding: 0rem 0.44rem 0rem 0rem;
    transform: scale(1.04);
  }
}
@media (min-width: 414px) {
  button#hamburger-menu {
    padding: 0rem 0.48rem 0rem 0rem;
    transform: scale(1.12);
  }
}
@media (min-width: 507px) {
  button#hamburger-menu {
    padding: 0rem 0.56rem 0rem 0rem;
    transform: scale(1.2);
  }
}
@media (min-width: 551px) {
  #header {
    top: 3.48rem;
  }
  #header #logo-mm {
    background-size: 3.6rem 3.6rem;
    height: 3.6rem;
    width: 3.6rem;
  }
  button#hamburger-menu {
    padding: 0rem 0.64rem 0rem 0rem;
    transform: scale(1.2);
  }
}
@media (min-width: 678px) {
  button#hamburger-menu {
    padding: 0rem 0.72rem 0rem 0rem;
    transform: scale(1.36);
  }
}
@media (min-width: 768px) {
  button#hamburger-menu {
    padding: 0rem 1rem 0rem 0rem;
    transform: scale(1.6);
  }
}
@media (min-width: 981px) {
  #header {
    top: 4.8rem;
  }
  #header #logo-mm {
    background-size: 4.2rem 4.2rem;
