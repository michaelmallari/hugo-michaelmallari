    right: 0px !important;
    width: 4.8rem;
  }
  .nav-primary {
    margin: 0px;
    padding: 0px;
  }
  .nav-primary li {
    margin: 0rem 0rem 0.12rem 0rem;
    text-align: center;
  }
  .nav-primary a {
    background: var(--color-white);
    height: 4.8rem;
    padding: 0px;
    -moz-transition: background 0.32s ease;
    -webkit-transition: background 0.32s ease;
    -o-transition: background 0.32s ease;
    -ms-transition: background 0.32s ease;
    transition: background 0.32s ease;
    width: 4.8rem;
  }
  .nav-primary a:hover,
  .nav-primary a:focus {
    background: var(--color-blue);
  }
  .nav-primary a span {
    display: inline-block;
    padding-top: 1.48rem;
    width: 100%;
  }
  .nav-primary a:hover span,
  .nav-primary a:focus span {
    color: var(--color-white);
  }
  .nav-primary a span:nth-child(2) {
    font-size: 0.68rem;
    width: 43%;
  }
  .nav-primary a:hover span:nth-child(2),
  .nav-primary a:focus span:nth-child(2) {
    color: var(--color-white);
  }
  .nav-primary li a span:nth-child(2) {
    position: relative;
    visibility: hidden;
  }
  .nav-primary li a span:nth-child(2):after {
    position: absolute;
    left: -1.32rem;
    text-align: center;
    top: 0.08rem;
    visibility: visible;
    width: 4.64rem;
  }
