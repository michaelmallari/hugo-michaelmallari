/* 

Primary:
PMS 2028 C #eb3300 (RGB: 235, 51, 0)

Complement:
PMS 2028 C #eb3300
PMS 3551 C #00a6c8 (RGB: 0, 166, 200)

Triadic:
PMS 265 C #9063cd (RGB: 144, 99, 205)
PMS 3501 C #4cae04 (RGB: 76, 174, 4)


Monochromatic PMS 433 C:
PMS 433 C #1d252d (RGB: 29, 37, 45)
PMS 431 C #5b6770 (RGB: 91, 103, 112)
PMS 5445 C #b7c9d3 (RGB: 183, 201, 211)

*/
@import url(https://use.fontawesome.com/releases/v6.7.2/css/all.css);
:root {
  --color-orange: #eb3300;
  --color-orange-dark: #ca3604;
  --color-orange-light: #ff7f41;
  --color-blue: #00a6c8;
  --color-blue-dark: #00587c;
  --color-blue-light: #3ccbda;
  --color-green: #4cae04;
  --color-green-dark: #257226;
  --color-green-light: #a7e163;
  --color-gray-dark: #1d252d;
  --color-gray-medium: #5b6770;
  --color-gray-light: #b7c9d3;
  --color-highlighter: #fdff32;
  --color-white: #fff;
  --color-off-white: #f5f5f5;
  --font-serif: 'Martel', serif;
  --font-sans-serif: 'Open Sans', 'Helvetica Neue', sans-serif;
}
@font-face {
  font-family: 'Martel';
  font-style: normal;
  font-weight: 200;
  src: url(https://fonts.gstatic.com/s/martel/v12/PN_yRfK9oXHga0XVqekqghzT.ttf) format('truetype');
}
@font-face {
